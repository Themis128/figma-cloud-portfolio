{
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true
      },
      "security": {
        "recommended": true,
        "noDangerouslySetInnerHtml": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn",
        "noDebugger": "warn"
      },
      "style": {
        "useConst": "error",
        "noMagicNumbers": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single"
    }
  },
  "files": {
    "includes": [
      "client/**/*.{js,jsx,ts,tsx}",
      "server/**/*.{js,ts}",
      "shared/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "tests/**/*.{js,ts,tsx}",
      "isolated-tests/**/*.{js,ts,tsx}",
      "playwright-tests/**/*.{js,ts,tsx}",
      "portfolio-nextjs/src/**/*.{js,jsx,ts,tsx}",
      "portfolio-nextjs/*.config.{js,ts}",
      "*.{js,ts,tsx}",
      "*.config.{js,ts}"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/.next/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/playwright-report/**",
        "**/performance-test-results/**",
        "**/test-results/**",
        "**/coverage/**",
        "amplify-build-config.json"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["test-backend-apis.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["playwright-tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["server/**/*.ts", "server/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "isolated-tests/**/*.ts",
        "isolated-tests/**/*.tsx",
        "playwright-tests/**/*.ts",
        "playwright-tests/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["portfolio-nextjs/src/components/Interactive3DDemo.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
