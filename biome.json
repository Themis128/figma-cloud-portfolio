{
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn",
        "noDebugger": "warn"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "style": {
        "useConst": "error",
        "noMagicNumbers": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single"
    }
  },
  "files": {
    "includes": [
      "client/**/*.{js,jsx,ts,tsx}",
      "server/**/*.{js,ts}",
      "shared/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "tests/**/*.{js,ts,tsx}",
      "isolated-tests/**/*.{js,ts,tsx}",
      "playwright-tests/**/*.{js,ts,tsx}",
      "portfolio-nextjs/**/*.{js,jsx,ts,tsx}",
      "*.{js,ts,tsx}",
      "*.config.{js,ts}"
    ],
    "ignoreUnknown": true
  },
  "overrides": [
    {
      "includes": [
        "**/.next/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/playwright-report/**",
        "**/performance-test-results/**",
        "**/test-results/**",
        "amplify-build-config.json"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["playwright-tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": ["vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
