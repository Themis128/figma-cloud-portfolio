{
  "$schema": "https://biomejs.dev/schemas/2.3.14/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "recommended": true,
        "useAltText": "error",
        "useAriaPropsForRole": "error",
        "useValidAriaRole": "error",
        "noAccessKey": "warn"
      },
      "security": {
        "recommended": true,
        "noDangerouslySetInnerHtml": "off",
        "noGlobalEval": "error"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noUnusedImports": "error",
        "noConstantCondition": "error",
        "noUnreachable": "error",
        "useExhaustiveDependencies": "warn",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "warn",
        "noConsole": "warn",
        "noDebugger": "warn",
        "noDoubleEquals": "error",
        "noShadowRestrictedNames": "error",
        "useAwait": "warn"
      },
      "style": {
        "useConst": "error",
        "noMagicNumbers": "warn",
        "useTemplate": "warn",
        "noNegationElse": "warn",
        "useSingleVarDeclarator": "error"
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": { "maxAllowedComplexity": 15 }
        },
        "noForEach": "off",
        "noBannedTypes": "warn",
        "useSimplifiedLogicExpression": "warn"
      },
      "performance": {
        "noAccumulatingSpread": "warn",
        "noDelete": "warn"
      },
      "nursery": {
        "useSortedClasses": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "single",
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2,
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "enabled": true,
      "indentWidth": 2
    }
  },
  "files": {
    "includes": [
      "client/**/*.{js,jsx,ts,tsx}",
      "server/**/*.{js,ts}",
      "shared/**/*.{js,ts}",
      "scripts/**/*.{js,ts}",
      "tests/**/*.{js,ts,tsx}",
      "isolated-tests/**/*.{js,ts,tsx}",
      "playwright-tests/**/*.{js,ts,tsx}",
      "portfolio-nextjs/src/**/*.{js,jsx,ts,tsx}",
      "portfolio-nextjs/*.config.{js,ts}",
      "*.{js,ts,tsx}",
      "*.config.{js,ts}"
    ]
  },
  "overrides": [
    {
      "includes": [
        "**/.next/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/playwright-report/**",
        "**/performance-test-results/**",
        "**/test-results/**",
        "**/coverage/**",
        "amplify-build-config.json"
      ],
      "linter": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["scripts/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["scripts/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["test-backend-apis.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["playwright-tests/**/*.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off",
            "noExplicitAny": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    },
    {
      "includes": ["server/**/*.ts", "server/**/*.js"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          },
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    },
    {
      "includes": [
        "tests/**/*.ts",
        "tests/**/*.tsx",
        "isolated-tests/**/*.ts",
        "isolated-tests/**/*.tsx",
        "playwright-tests/**/*.ts",
        "playwright-tests/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["portfolio-nextjs/src/components/Interactive3DDemo.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noMagicNumbers": "off"
          }
        }
      }
    }
  ]
}
