# Real API Testing Environment Variables
# Copy this file to .env.test and fill in your REAL API credentials
#
# WARNING: These are for TESTING only
# - Use separate test/staging keys when possible
# - Never commit real credentials to git
# - These will make REAL API calls during tests

# ============================================
# FIREBASE (Free tier - safe for testing)
# ============================================
VITE_FIREBASE_API_KEY=your_test_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-test-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-test-project
VITE_FIREBASE_STORAGE_BUCKET=your-test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_test_sender_id
VITE_FIREBASE_APP_ID=your_test_app_id
VITE_FIREBASE_VAPID_KEY=your_test_vapid_key

# ============================================
# GITHUB API (Free tier: 5000 req/hr)
# ============================================
GITHUB_TOKEN=ghp_your_test_github_token
VITE_GITHUB_TOKEN=ghp_your_test_github_token

# ============================================
# GOOGLE ANALYTICS (Free - creates test data)
# ============================================
VITE_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# GOOGLE RECAPTCHA v3 (Free)
# ============================================
VITE_RECAPTCHA_SITE_KEY=your_test_site_key
RECAPTCHA_SECRET_KEY=your_test_secret_key

# ============================================
# ANTHROPIC CLAUDE (⚠️ COSTS MONEY)
# ============================================
# Pricing: $0.25/MTok input, $1.25/MTok output (claude-3-haiku)
# Only enable if you have budget for testing
VITE_ANTHROPIC_API_KEY=sk-ant-api03-your_test_key

# ============================================
# OPENAI (⚠️ COSTS MONEY)
# ============================================
# Pricing varies by model
# Only enable if you have budget for testing
VITE_OPENAI_API_KEY=sk-your_test_openai_key
VITE_AI_MODEL=gpt-4o-mini

# ============================================
# SENTRY (Free tier: 5K events/month)
# ============================================
VITE_SENTRY_DSN=https://your_test_key@oXXXXXX.ingest.sentry.io/XXXXXX
SENTRY_DSN=https://your_test_key@oXXXXXX.ingest.sentry.io/XXXXXX
SENTRY_ACCESS_TOKEN=sntrys_your_test_token
SENTRY_ORG_SLUG=your-test-org

# ============================================
# SOCKET.IO (Local server - no external API)
# ============================================
VITE_SOCKET_URL=http://localhost:3000

# ============================================
# TEST CONFIGURATION
# ============================================
# Control which APIs to actually test
TEST_GITHUB_API=true
TEST_FIREBASE=true
TEST_ANALYTICS=true
TEST_RECAPTCHA=true
TEST_SENTRY=true
TEST_SOCKETIO=true

# Only enable if you have budget
TEST_ANTHROPIC=false
TEST_OPENAI=false

# Rate limiting configuration
RATE_LIMIT_DELAY_MS=1000
MAX_CONCURRENT_REQUESTS=2

# Test data cleanup
CLEANUP_TEST_DATA=true
