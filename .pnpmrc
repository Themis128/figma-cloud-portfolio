auto-install-peers=false
cache-dir=node_modules/.pnpm-cache
child-concurrency=5
hoist-pattern=*
network-concurrency=16
prefer-frozen-lockfile=false
public-hoist-pattern=*
state-dir=node_modules/.pnpm-state
store-dir=~/.pnpm-store
verify-deps-before-run=false
only-built-dependencies=["@swc/core","esbuild","puppeteer","sharp"]
# Override environment variables to prevent npm warnings
PNPM_AUTO_INSTALL_PEERS=
PNPM_CACHE_DIR=
PNPM_CHILD_CONCURRENCY=
PNPM_HOIST_PATTERN=
PNPM_NETWORK_CONCURRENCY=
PNPM_PREFER_FROZEN_LOCKFILE=
PNPM_PUBLIC_HOIST_PATTERN=
PNPM_STATE_DIR=
PNPM_STORE_DIR=
PNPM_VERIFY_DEPS_BEFORE_RUN=
PNPM_JSR_REGISTRY=
# Also override NPM_CONFIG equivalents
NPM_CONFIG_AUTO_INSTALL_PEERS=
NPM_CONFIG_CACHE_DIR=
NPM_CONFIG_CHILD_CONCURRENCY=
NPM_CONFIG_HOIST_PATTERN=
NPM_CONFIG_NETWORK_CONCURRENCY=
NPM_CONFIG_PREFER_FROZEN_LOCKFILE=
NPM_CONFIG_PUBLIC_HOIST_PATTERN=
NPM_CONFIG_STATE_DIR=
NPM_CONFIG_STORE_DIR=
NPM_CONFIG_VERIFY_DEPS_BEFORE_RUN=
NPM_CONFIG_JSR_REGISTRY=