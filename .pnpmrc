# pnpm configuration
auto-install-peers=false
resolution-mode=highest
strict-peer-dependencies=false
only-built-dependencies=["@swc/core","esbuild","puppeteer","sharp"]
enable-pre-post-scripts=true
ignore-scripts=false

# Suppress npm warnings
npm-config-ignore-workspace-root-check=true

# Shell Integration for improved command detection
# Enable shell tab completion
enable-shell-completion=true
