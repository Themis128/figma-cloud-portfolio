{
  "name": "baltzakis-portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "start:test-dashboard": "tsx scripts/start-test-dashboard-simple.ts",
    "build": "run-s build:resume build:client build:server",
    "build:ci": "run-s build:resume build:client build:server",
    "build:analyze": "vite build --mode analyze",
    "build:client": "vite build",
    "build:resume": "node scripts/build-resume.js",
    "build:server": "vite build --config vite.config.server.ts",
    "dev": "vite",
    "dev:ci": "vite",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm exec tsx server/node-build.ts\"",
    "format": "biome format .",
    "format:check": "biome check .",
    "format:fix": "biome format --write .",
    "generate-resume": "run-s generate-resume-html build:resume",
    "generate-resume-html": "node scripts/generate-resume-html.js",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "optimize-images": "node scripts/optimize-images.js",
    "quality": "node scripts/quality-check.js",
    "quality:ci": "node scripts/quality-check.js",
    "coverage": "bash scripts/run-coverage.sh",
    "coverage:upload": "bash scripts/run-codacy-coverage.sh",
    "codacy:mcp": "node scripts/codacy-mcp-endpoint.js",
    "setup:fonts": "powershell -ExecutionPolicy Bypass -File scripts/setup-terminal-fonts.ps1",
    "start": "node dist/server/node-build.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --config=playwright.config.fast.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:dashboard": "node scripts/run-playwright-with-dashboard.js",
    "test:e2e:watch": "node scripts/run-playwright-with-dashboard.js watch",
    "test:e2e:dashboard:ui": "run-s test:e2e:dashboard --playwright test --ui",
    "test:unit": "vitest run",
    "typecheck": "tsc",
    "clean": "rm -rf dist coverage test-results playwright-report .codacy-cli-v2",
    "clean:deps": "rm -rf node_modules pnpm-lock.yaml",
    "pnpm:optimize": "node scripts/pnpm-optimize.js",
    "postinstall": "node scripts/postinstall.js || true"
  },
  "dependencies": {
    "@agentdeskai/browser-tools-mcp": "^1.2.1",
    "@sentry/node": "^10.36.0",
    "@sentry/react": "^10.36.0",
    "@sentry/tracing": "^7.120.4",
    "@testing-library/dom": "^10.4.1",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "dotenv": "^17.2.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "express": "^5.2.1",
    "firebase": "^12.8.0",
    "next": "^16.1.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-ga4": "^2.1.0",
    "react-google-recaptcha-v3": "^1.11.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "web-push": "^3.6.7",
    "web-vitals": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.20.0",
