{
  "name": "baltzakis-portfolio-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Modern portfolio built with Next.js 16, React 19, and TypeScript",
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx server/index.ts",
    "dev:bot": "cd server/bot && ./venv/bin/uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "predev:all": "bash scripts/amplify-status.sh",
    "dev:all": "concurrently -n \"next,server\" -c \"cyan,yellow\" \"next dev\" \"tsx server/index.ts\"",
    "amplify:status": "bash scripts/amplify-status.sh",
    "amplify:dev": "pnpm --package=@aws-amplify/backend-cli dlx ampx sandbox",
    "amplify:deploy": "pnpm --package=@aws-amplify/backend-cli dlx ampx pipeline-deploy --branch production --app-id d1zjif7pi1h3om",
    "amplify:outputs": "pnpm --package=@aws-amplify/backend-cli dlx ampx generate outputs --branch production --app-id d1zjif7pi1h3om",
    "amplify:delete": "pnpm --package=@aws-amplify/backend-cli dlx ampx sandbox delete",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "build:server": "tsc --project server/tsconfig.server.json && mv dist/server/index.js dist/server/node-build.mjs",
    "start": "next start",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:ci": "playwright test --config=playwright.config.ci.ts",
    "test:playwright:fast": "playwright test --config=playwright.config.fast.ts",
    "test:playwright:isolated": "playwright test --config=playwright.config.isolated.ts",
    "test:playwright:validation": "tsx playwright.config.validation.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config=playwright.config.ci.ts",
    "test:e2e:fast": "playwright test --config=playwright.config.fast.ts",
    "test:e2e:isolated": "playwright test --config=playwright.config.isolated.ts",
    "test:e2e:autofix": "playwright test --config=playwright.config.fast.ts --reporter=playwright-tests/autofix-reporter.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1009.0",
    "@aws-sdk/client-ses": "^3.1007.0",
    "@builder.io/react": "^9.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
