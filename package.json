{
  "name": "baltzakis-portfolio-nextjs",
  "version": "1.0.0",
  "private": true,
  "description": "Modern portfolio built with Next.js 16, React 19, and TypeScript",
  "scripts": {
    "dev": "next dev",
    "dev:server": "tsx server/index.ts",
    "dev:bot": "cd server/bot && uvicorn main:app --reload --host 0.0.0.0 --port 8001",
    "dev:all": "concurrently -n \"next,server,bot\" -c \"cyan,yellow,magenta\" \"next dev\" \"tsx server/index.ts\" \"pnpm dev:bot\"",
    "build": "next build",
    "build:server": "tsc --project server/tsconfig.server.json && mv dist/server/index.js dist/server/node-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:playwright:ci": "playwright test --config=playwright.config.ci.ts",
    "test:playwright:fast": "playwright test --config=playwright.config.fast.ts",
    "test:playwright:isolated": "playwright test --config=playwright.config.isolated.ts",
    "test:playwright:validation": "tsx playwright.config.validation.ts",
    "test:e2e": "playwright test",
    "test:e2e:ci": "playwright test --config=playwright.config.ci.ts",
    "test:e2e:fast": "playwright test --config=playwright.config.fast.ts",
    "test:e2e:isolated": "playwright test --config=playwright.config.isolated.ts",
    "test:e2e:autofix": "playwright test --config=playwright.config.fast.ts --reporter=playwright-tests/autofix-reporter.js",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@builder.io/react": "^9.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@sentry/nextjs": "^10.36.0",
    "@tanstack/react-query": "^5.90.19",
    "@testing-library/dom": "^10.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "express": "^5.2.1",
    "firebase": "^12.9.0",
    "framer-motion": "^12.29.0",
    "input-otp": "^1.4.2",
    "jsdom": "^28.1.0",
    "lucide-react": "^0.539.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "react": "18.3.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^2.15.4",
    "socket.io-client": "^4.8.3",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "three": "^0.182.0",
    "vaul": "^1.1.2",
    "web-vitals": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.4",
