    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "puppeteer": "^24.36.0",
    "puppeteer-core": "^24.36.0",
    "react-day-picker": "^9.13.0",
    "react-hook-form": "^7.71.1",
    "react-resizable-panels": "^3.0.6",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.15.4",
    "rollup-plugin-visualizer": "^5.14.0",
    "serverless-http": "^3.2.0",
    "sharp": "^0.34.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.182.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^7.3.1",
    "vite-plugin-image-optimizer": "^1.1.9",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.14.0+sha512.ad27a79641b49c3e481a16a805baa71817a04bbe06a38d17e60e2eaee83f6a146c6a688125f5792e48dd5ba30e7da52a5cda4c3992b9ccf333f9ce223af84748",
  "pnpm": {
    "overrides": {
      "glob": "^10.5.0",
      "minimatch": "^9.0.5",
      "semver": "^7.6.3"
    },
    "ignoredBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "puppeteer",
      "sharp",
      "better-sqlite3",
      "canvas"
    ],
    "peerDependencyRules": {
      "ignoreMissing": [
        "@types/react",
        "@types/react-dom",
        "typescript",
        "webpack"
      ]
    }
  },
  "pkg": {
    "assets": [
      "dist/spa/*"
    ],
    "scripts": [
      "dist/server/**/*.js"
    ]
  },
  "version": "1.0.0",
  "description": "A modern, full-stack portfolio website built with React, TypeScript, Express, and deployed on AWS Amplify.",
  "main": "postcss.config.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "keywords": [],
