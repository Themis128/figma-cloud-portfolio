# =============================================================================
# Portfolio App — Environment Variables
# Copy to .env.local and fill in your values
# =============================================================================

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:8082
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_VERSION=1.0.0

# ── Google Analytics ─────────────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=
GOOGLE_ANALYTICS_MEASUREMENT_ID=
GOOGLE_ANALYTICS_API_SECRET=

# ── Sentry (Error Tracking) ─────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=

# ── reCAPTCHA v3 (Contact Form) ─────────────────────────────────────────────
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── AWS Bedrock (Chatbot) ───────────────────────────────────────────────────
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0

# ── GitHub (API access for projects page) ────────────────────────────────────
# Fine-grained PAT with no repo access (public read only, 5000 req/hr)
# Generate at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=
GITHUB_USERNAME=Themis128

# ── Slack (Contact form notifications) ───────────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Web Push (Push notifications) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your-email@example.com

# ── Lambda URLs (Production — leave empty for local dev) ─────────────────────
NEXT_PUBLIC_LAMBDA_CONTACT_URL=
NEXT_PUBLIC_LAMBDA_RESUME_URL=
NEXT_PUBLIC_LAMBDA_PUSH_NOTIFICATIONS_URL=
NEXT_PUBLIC_LAMBDA_PING_URL=
NEXT_PUBLIC_LAMBDA_CHAT_URL=

# ── Snyk (Security scanning — CI only, not needed locally) ──────────────────
# SNYK_TOKEN=
# SNYK_ORG=

# ── Misc ─────────────────────────────────────────────────────────────────────
PING_MESSAGE=ping_pong
