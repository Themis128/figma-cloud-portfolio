# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================

# Core Environment
NODE_ENV=development  # development | production

# =============================================================================
# AWS CONFIGURATION
# =============================================================================

# AWS Configuration (Required for Amplify Deployment)
# Get these from AWS IAM Console -> Users -> Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=eu-central-1

# AWS SES Configuration (for sending emails)
# This is the email address that will send confirmation emails
# Must be verified in AWS SES Console: https://console.aws.amazon.com/ses/home
# 
# Setup steps:
# 1. Go to AWS SES Console → Verified identities → Create identity
# 2. Enter your email and verify it via the confirmation email
# 3. Update this value with your verified email
#
# Note: In SES sandbox mode, you can only send TO verified emails
# Request production access to send to any email address
SES_VERIFIED_EMAIL=noreply@cloudless.gr

# AWS Secrets Manager (for production secrets storage)
AWS_SECRETS_MANAGER_ID=portfolio/env

# AWS Amplify App IDs — confirmed via `aws amplify list-apps` (2026-02-18)
# App name : baltzakis-portfolio | Region: eu-central-1
# Only one app exists. Both prod & staging use the same app ID; staging is a branch.
AMPLIFY_PRODUCTION_APP_ID=d25rpobpd22vvg
AMPLIFY_STAGING_APP_ID=d25rpobpd22vvg

# Firebase Configuration
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# VAPID Key for FCM (generate in Firebase Console -> Project Settings -> Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# AWS Amplify Lambda Function URLs
# These will be provided by Amplify after deployment
VITE_LAMBDA_CONTACT_URL=https://your-contact-function-url.amazonaws.com
VITE_LAMBDA_RESUME_URL=https://your-resume-function-url.amazonaws.com
VITE_LAMBDA_PUSH_NOTIFICATIONS_URL=https://your-push-notifications-function-url.amazonaws.com
VITE_LAMBDA_PING_URL=https://your-ping-function-url.amazonaws.com
VITE_LAMBDA_DEMO_URL=https://your-demo-function-url.amazonaws.com

# Optional: Base API URL if all functions share the same domain
# VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com

# Server-side Firebase Admin (for sending push notifications)
# These would be used in a server environment, not in Vite
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_service_account_email

# Sentry Configuration for Error Tracking and Performance Monitoring
# Get these from your Sentry project settings at: https://sentry.io/settings/projects/
#
# Development values (100% sampling for debugging):
VITE_SENTRY_DSN=your_sentry_dsn_here
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0
SENTRY_ACCESS_TOKEN=your_sentry_access_token
SENTRY_ORG_SLUG=your_sentry_org_slug
#
# Production values (10% sampling for cost optimization):
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_PROFILES_SAMPLE_RATE=0.1

# Optional: App version for release tracking
VITE_APP_VERSION=1.0.0

# AI API Configuration (choose one or both)
# OpenAI API Key - Get from https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude API Key - Get from https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Together AI API Key - Get from https://api.together.xyz/settings/api-keys
VITE_TOGETHER_API_KEY=your_together_api_key_here

# AI Model Configuration (optional - defaults provided)
VITE_AI_MODEL=gpt-4o-mini  # or gpt-3.5-turbo for OpenAI
VITE_AI_PROVIDER=openai     # or 'together'

# AI Configuration (Ollama - local AI models)
VITE_AI_PROVIDER=ollama
VITE_AI_MODEL=llama2
VITE_OLLAMA_BASE_URL=http://localhost:11434/v1

# reCAPTCHA Configuration
VITE_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
VITE_RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
NUXT_PUBLIC_RECAPTCHA_ENABLED=true
NUXT_PUBLIC_RECAPTCHA_ACTION_CONTACT=contact_form_submit
RECAPTCHA_ACTION_CONTACT=contact_form_submit
VITE_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Google Analytics
VITE_GOOGLE_ANALYTICS_ID=G-FT79QM66D3
VITE_GOOGLE_ANALYTICS_MEASUREMENT_ID=G-FT79QM66D3

# Figma API (for design integration)
FIGMA_API_KEY=your_figma_api_key
FIGMA_FILE_KEY=your_figma_file_key
FIGMA_CLIENT_ID=your_figma_client_id
FIGMA_CLIENT_SECRET=your_figma_client_secret

# Codacy (Code Quality)
CODACY_API_TOKEN=your_codacy_api_token
CODACY_PROJECT_TOKEN=your_codacy_project_token
CODACY_ORGANIZATION_PROVIDER=gh
CODACY_USERNAME=Themis128
CODACY_PROJECT_NAME=figma-cloud-portfolio

# GitHub Token (for API access)
# Get from: https://github.com/settings/tokens
# Required scopes: repo, workflow, read:user
GITHUB_TOKEN=your_github_personal_access_token
VITE_GITHUB_TOKEN=your_github_personal_access_token

# Server Configuration
PING_MESSAGE="ping pong"

# Contact Form API
CONTACT_FORM_API_URL=https://api-dev.baltzakisthemis.com/contact

# Slack Webhook URL (for contact form notifications)
# Get from: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL


# AWS SNS for Push Notifications (replaces Firebase)
# Note: Currently using Web Push API with VAPID keys instead of AWS SNS
# VITE_AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789:portfolio-notifications

# AWS SNS Public Key for Web Push (VAPID key equivalent)
VITE_AWS_SNS_PUBLIC_KEY=your_aws_sns_public_key_here

# Database (PostgreSQL) for Prisma ORM
# Example: DATABASE_URL="postgresql://user:password@localhost:5432/figma_cloud_portfolio"
DATABASE_URL="postgresql://user:password@localhost:5432/figma_cloud_portfolio"
