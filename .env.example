# Firebase Configuration
# Get these values from your Firebase project settings
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# VAPID Key for FCM (generate in Firebase Console -> Project Settings -> Cloud Messaging)
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here

# AWS Amplify Lambda Function URLs
# These will be provided by Amplify after deployment
VITE_LAMBDA_CONTACT_URL=https://your-contact-function-url.amazonaws.com
VITE_LAMBDA_RESUME_URL=https://your-resume-function-url.amazonaws.com
VITE_LAMBDA_PUSH_NOTIFICATIONS_URL=https://your-push-notifications-function-url.amazonaws.com
VITE_LAMBDA_PING_URL=https://your-ping-function-url.amazonaws.com
VITE_LAMBDA_DEMO_URL=https://your-demo-function-url.amazonaws.com

# Optional: Base API URL if all functions share the same domain
# VITE_API_BASE_URL=https://your-api-gateway-url.amazonaws.com

# Server-side Firebase Admin (for sending push notifications)
# These would be used in a server environment, not in Vite
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key_here
FIREBASE_CLIENT_EMAIL=your_service_account_email